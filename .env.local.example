# Get these from your Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key - server-side only, NEVER expose to the client or commit to git
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Your deployed site URL (used for server-to-server calls); leave blank for local dev
NEXT_PUBLIC_SITE_URL=

# Optional - only needed once you wire up a real SMS provider
SMS_API_KEY=
